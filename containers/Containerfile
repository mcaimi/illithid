FROM docker.io/library/golang:1.27-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o /illithid ./cmd/illithid

FROM docker.io/library/debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /illithid /usr/local/bin/illithid

RUN mkdir -p /etc/illithid
VOLUME /etc/illithid

EXPOSE 67/udp 8080/tcp

ENTRYPOINT ["illithid"]
CMD ["-config", "/etc/illithid/parameters.yaml"]
